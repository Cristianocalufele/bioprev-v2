# Server
PORT=3000

# Store Admin Authentication (configure in Secrets / Vercel Environment Variables)
# Set either ADMIN_PASSCODE or ADMIN_PASSWORD to protect /admin/login and /admin
ADMIN_PASSCODE=
ADMIN_PASSWORD=
ADMIN_EMAIL=bioprevloja@site.ao

# Turso / libSQL Store Database (configure in Vercel Environment Variables)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary Product Media (configure in Vercel Environment Variables)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PostgreSQL / Drizzle (optional)
DATABASE_URL=
